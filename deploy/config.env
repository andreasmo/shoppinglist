# Deploy-Konfiguration für bunny.net – enthält keine Geheimnisse (darf ins Repo).
# DB-Zugangsdaten schreibt `bunny db create --save-env` nach .env (nicht im Repo).

# Profil der Bunny-CLI (bunny login --profile <name>); wird an jeden Aufruf angehängt.
BUNNY_PROFILE=default

# Ressourcennamen auf bunny.net
DB_NAME=einkauf
DB_PRIMARY_REGION=DE
SCRIPT_NAME=einkauf-api
SITE_NAME=einkauf
SITE_REGION=DE

# Eigene Domains. Sie werden erst benutzt, wenn deploy/domains.sh sie verknüpft hat –
# bis dahin laufen App und API unter *.b-cdn.net. Die CNAME-Ziele gibt setup.sh aus.
APP_DOMAIN=einkauf.example.com
API_DOMAIN=api.einkauf.example.com
