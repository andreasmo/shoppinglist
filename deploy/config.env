# Deploy-Konfiguration für bunny.net – enthält keine Geheimnisse (darf ins Repo).
# Eigene Werte (z. B. Domains, CLI-Profil) gehören nach deploy/config.local.env (nicht im Repo);
# dort gesetzte Schlüssel überschreiben die Werte hier.
# DB-Zugangsdaten schreibt `bunny db create --save-env` nach .env (nicht im Repo).

# Profil der Bunny-CLI (bunny login --profile <name>); wird an jeden Aufruf angehängt.
BUNNY_PROFILE=default

# Ressourcennamen auf bunny.net
DB_NAME=einkauf
DB_PRIMARY_REGION=DE
SCRIPT_NAME=einkauf-api
SITE_NAME=einkauf
SITE_REGION=DE

# Eigene Domains (optional), z. B. APP_DOMAIN=einkauf.example.com und API_DOMAIN=api.einkauf.example.com.
# Sie werden erst benutzt, wenn deploy/domains.ps1 sie verknüpft hat – bis dahin laufen App und API
# unter *.b-cdn.net. Die CNAME-Ziele gibt setup.ps1 aus.
APP_DOMAIN=
API_DOMAIN=
